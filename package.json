{
  "name": "sanakenno-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @sanakenno/server --filter @sanakenno/web dev",
    "dev:server": "pnpm --filter @sanakenno/server dev",
    "dev:web": "pnpm --filter @sanakenno/web dev",
    "build": "pnpm --filter @sanakenno/web build",
    "typecheck": "pnpm -r typecheck && tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test:arch": "vitest run tests/architecture.test.ts",
    "test:unit": "vitest run --exclude tests/architecture.test.ts",
    "test:coverage": "vitest run --coverage --exclude tests/architecture.test.ts",
    "screenshot": "tsx scripts/screenshot.ts",
    "db:seed": "pnpm --filter @sanakenno/server db:seed",
    "db:migrate-v1": "tsx scripts/migrate-v1-db.ts",
    "check:agent": "pnpm run format && pnpm run typecheck && pnpm run lint && pnpm run test:arch && pnpm run test:unit && pnpm run build"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "better-sqlite3",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "3.2.7",
    "argon2": "^0.45.1",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jsdom": "^29.0.1",
    "prettier": "^3.5.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.57.2",
    "vitest": "^3.2.4"
  }
}
